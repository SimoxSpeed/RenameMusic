# Keystore con cui si firmano gli APK di RenameMusic. Copia questo file in
# keystore.properties (ignorato da git) e indica il keystore delle versioni
# pubblicate: con un altro keystore gli aggiornamenti verrebbero rifiutati e
# l'accesso a Google non funzionerebbe (mobile/signing.ps1 controlla lo SHA-1).
# Nei percorsi usa / al posto di \ (nei .properties \ è un carattere di escape);
# un percorso relativo parte da frontend/android.
storeFile=C:/percorso/del/keystore/debug.keystore
storePassword=android
keyAlias=androiddebugkey
keyPassword=android
