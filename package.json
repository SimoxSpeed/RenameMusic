{
  "name": "renamemusic",
  "private": true,
  "scripts": {
    "setup": "npm --prefix frontend install",
    "dev": "wails dev",
    "build": "wails build",
    "build:frontend": "npm --prefix frontend run build",
    "pretest": "node -e \"process.exit(require('fs').existsSync('frontend/dist/index.html') ? 0 : 1)\" || npm run build:frontend",
    "test": "go test ./...",
    "lint": "npm --prefix frontend run lint",
    "format": "npm --prefix frontend run format",
    "format:check": "npm --prefix frontend run format:check",
    "check": "npm run build:frontend && npm run lint && npm run format:check && go vet ./... && go test ./...",
    "apk:build": "powershell -NoProfile -ExecutionPolicy Bypass -File mobile/build-apk.ps1",
    "apk:install": "powershell -NoProfile -ExecutionPolicy Bypass -File mobile/install-apk.ps1",
    "apk": "powershell -NoProfile -ExecutionPolicy Bypass -File mobile/install-apk.ps1 -Build",
    "release": "powershell -NoProfile -ExecutionPolicy Bypass -File release.ps1"
  }
}
